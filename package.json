{
  "name": "ummka",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "26.13.1",
    "npm": "11.20.0"
  },
  "packageManager": "npm@11.20.0",
  "knip": {
    "entry": [
      "scripts/webview-check/check.ts"
    ],
    "ignoreBinaries": [
      "openssl"
    ],
    "ignore": [
      "vendor/mattermost/**"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "biome ci --error-on-warnings .",
    "unused": "knip",
    "test": "vitest run --environment jsdom src && npm run test:rest",
    "test:rest": "node --test scripts/contract/transport.test.ts scripts/contract/installation-profile.test.ts scripts/contract/team-reads.test.ts",
    "test:native-http": "node scripts/native-http/check.ts",
    "contract:build": "node scripts/contract/schema.ts",
    "contract:test": "node --test scripts/contract/contract.test.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tauri-apps/cli": "2.12.6",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "knip": "6.48.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  }
}
