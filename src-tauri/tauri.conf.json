{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ummka",
  "version": "../package.json",
  "identifier": "io.github.muxx.ummka.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ummka"
      }
    ],
    "security": {
      "csp": "default-src 'self'; object-src 'none'; base-uri 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self' ws://localhost:1420; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/macos/icon.icns",
      "icons/windows/icon.ico",
      "icons/linux/hicolor/128x128/apps/ummka.png"
    ]
  }
}
