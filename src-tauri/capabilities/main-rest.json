{
  "identifier": "main-rest",
  "description": "The local main WebView manages its own Mattermost REST connections and exchanges.",
  "local": true,
  "webviews": [
    "main"
  ],
  "permissions": [
    "allow-open-rest-connection",
    "allow-get-current-account-id",
    "allow-list-account-ids",
    "allow-forget-local-account",
    "allow-sign-out-account",
    "allow-sign-out-on-device",
    "allow-close-rest-connection",
    "allow-read-channel-window",
    "allow-begin-channel-history-load",
    "allow-store-channel-history-page",
    "allow-cancel-channel-history-load",
    "allow-prepare-rest-request",
    "allow-send-rest-request",
    "allow-read-rest-body",
    "allow-cancel-rest-request"
  ]
}
