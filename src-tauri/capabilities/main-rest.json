{
  "identifier": "main-rest",
  "description": "The local main WebView manages its own Mattermost REST connections and exchanges.",
  "local": true,
  "webviews": [
    "main"
  ],
  "permissions": [
    "allow-open-rest-connection",
    "allow-close-rest-connection",
    "allow-prepare-rest-request",
    "allow-send-rest-request",
    "allow-read-rest-body",
    "allow-cancel-rest-request"
  ]
}
