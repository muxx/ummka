{
  "identifier": "main-rest",
  "description": "The local main WebView manages its own Mattermost REST connections and exchanges.",
  "local": true,
  "webviews": [
    "main"
  ],
  "permissions": [
    "allow-open-rest-connection",
    "allow-get-current-account-id",
    "allow-list-account-ids",
    "allow-forget-local-account",
    "allow-sign-out-account",
    "allow-sign-out-on-device",
    "allow-close-rest-connection",
    "allow-read-composer-draft",
    "allow-save-composer-draft",
    "allow-stage-composer-post",
    "allow-read-pending-posts",
    "allow-read-workspace-settings",
    "allow-begin-workspace-policy-load",
    "allow-store-workspace-policy",
    "allow-cancel-workspace-policy-load",
    "allow-read-joined-teams",
    "allow-select-joined-team",
    "allow-begin-team-directory-load",
    "allow-store-team-directory",
    "allow-cancel-team-directory-load",
    "allow-read-saved-profiles",
    "allow-store-channel-profiles",
    "allow-read-team-sidebar",
    "allow-select-sidebar-channel",
    "allow-begin-sidebar-load",
    "allow-store-team-sidebar",
    "allow-cancel-sidebar-load",
    "allow-read-channel-window",
    "allow-begin-channel-history-load",
    "allow-store-channel-history-page",
    "allow-cancel-channel-history-load",
    "allow-prepare-rest-request",
    "allow-send-rest-request",
    "allow-read-rest-body",
    "allow-cancel-rest-request"
  ]
}
