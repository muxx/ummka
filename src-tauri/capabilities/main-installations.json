{
  "identifier": "main-installations",
  "description": "The local main WebView can list, select, remember and forget Mattermost installations.",
  "local": true,
  "webviews": ["main"],
  "permissions": [
    "allow-list-installations",
    "allow-read-installation-selection",
    "allow-select-installation",
    "allow-connect-installation",
    "allow-remember-installation",
    "allow-forget-installation"
  ]
}
