<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:testOnly="true">
        <activity android:name=".BrowserCheckActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="mailto" android:ssp="probe@ummka.invalid" />
            </intent-filter>
        </activity>
        <service android:name=".BrowserCheckService" android:exported="true">
            <intent-filter>
                <action android:name="android.support.customtabs.action.CustomTabsService" />
                <category android:name="androidx.browser.auth.category.AuthTab" />
            </intent-filter>
        </service>
        <receiver android:name=".HttpCheckAdmin" android:permission="android.permission.BIND_DEVICE_ADMIN" android:exported="true">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/http_check_admin" />
            <intent-filter><action android:name="android.app.action.DEVICE_ADMIN_ENABLED" /></intent-filter>
        </receiver>
    </application>
    <instrumentation android:name="io.github.muxx.ummka.dev.HttpCheckInstrumentation" android:targetPackage="${applicationId}" />
</manifest>
