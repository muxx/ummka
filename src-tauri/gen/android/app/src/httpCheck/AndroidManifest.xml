<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:testOnly="true">
        <receiver android:name=".HttpCheckAdmin" android:permission="android.permission.BIND_DEVICE_ADMIN" android:exported="true">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/http_check_admin" />
            <intent-filter><action android:name="android.app.action.DEVICE_ADMIN_ENABLED" /></intent-filter>
        </receiver>
    </application>
    <instrumentation android:name="io.github.muxx.ummka.dev.HttpCheckInstrumentation" android:targetPackage="${applicationId}" />
</manifest>
