{
  "files": {
    "includes": [
      "src/**",
      "scripts/contract/**",
      "vite.config.ts",
      "tsconfig.json",
      "biome.json",
      "package.json"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "security": {
        "noDangerouslySetInnerHtml": "error"
      }
    }
  }
}
